# ============================================================
# VDR - variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versionar .env.
# ============================================================

# --- Banco de dados (host = localhost para dev na máquina) ---
# Observação: a porta 5432 pode estar ocupada por outro postgres local;
# por isso o compose mapeia o nosso db para 5433 no host.
POSTGRES_USER=vdr
POSTGRES_PASSWORD=vdr
POSTGRES_DB=vdr
DATABASE_URL=postgresql://vdr:vdr@127.0.0.1:5433/vdr?schema=public
DATABASE_URL_TEST=postgresql://vdr:vdr@127.0.0.1:5433/vdr_test?schema=public

# --- API ---
PORT=3000
NODE_ENV=development

# --- Sessão / cookies ---
SESSION_SECRET=replace-me-troque-antes-de-producao
CARD_ENCRYPTION_KEY=replace-me-use-uma-chave-secreta-exclusiva-para-cartoes
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=480
INVITE_TOKEN_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_HOURS=1

# --- Seed: admin padrão (somente desenvolvimento) ---
ADMIN_EMAIL=admin@vdr.local
ADMIN_PASSWORD=change-me-strong-password

# --- E-mail ---
# Sem provedor real no momento: as mensagens são apenas logadas
# (convites e recuperação de senha NÃO são entregues).

# --- OCR (PaddleOCR local, sem serviço pago) ---
# OCR_PROVIDER=paddleocr|gemini|neutro (gemini existe no código mas está desativado por
# padrão neste projeto: exige GEMINI_API_KEY paga/limitada. Ver docs/INCIDENTE_OCR_PRODUCAO_DIAGNOSTICO.md)
OCR_PROVIDER=paddleocr
# Executa extração automaticamente após o upload de um comprovante
OCR_AUTO_ON_UPLOAD=true
# URL interna do serviço PaddleOCR
OCR_PADDLE_URL=http://ocr:8000
# Tempo limite máximo por leitura, em ms
OCR_TIMEOUT_MS=20000
# Só usadas se OCR_PROVIDER=gemini (desativado por padrão)
# GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000

# ============================================================
# Produção (compose.prod.yml) — imagens GHCR + deploy
# ============================================================

# Versão das imagens usada pela composição (o CD define por SHA)
IMAGE_TAG=latest
# Portas expostas no host (API fica restrita a 127.0.0.1)
API_PORT=3000
WEB_PORT=3001

# Em produção use segredos fortes e COOKIE_SECURE=true; se habilitar
# TLS externo (proxy/load balancer na sua rede), os cookies seguros
# funcionam pois o tráfego termina na sua infraestrutura.
# COOKIE_SECURE=true