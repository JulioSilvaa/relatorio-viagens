# ============================================================
# VDR - variáveis de ambiente (exemplo)
# Copie para .env e ajuste. NUNCA versionar .env.
# ============================================================

# --- Banco de dados (host = localhost para dev na máquina) ---
# Observação: a porta 5432 pode estar ocupada por outro postgres local;
# por isso o compose mapeia o nosso db para 5433 no host.
POSTGRES_USER=vdr
POSTGRES_PASSWORD=vdr
POSTGRES_DB=vdr
DATABASE_URL=postgresql://vdr:vdr@127.0.0.1:5433/vdr?schema=public
DATABASE_URL_TEST=postgresql://vdr:vdr@127.0.0.1:5433/vdr_test?schema=public

# --- API ---
PORT=3000
NODE_ENV=development

# --- Sessão / cookies ---
SESSION_SECRET=replace-me-troque-antes-de-producao
CARD_ENCRYPTION_KEY=replace-me-use-uma-chave-secreta-exclusiva-para-cartoes
COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=480
INVITE_TOKEN_EXPIRES_HOURS=72
PASSWORD_RESET_EXPIRES_HOURS=1

# --- Seed: admin padrão (somente desenvolvimento) ---
ADMIN_EMAIL=admin@vdr.local
ADMIN_PASSWORD=change-me-strong-password

# --- E-mail ---
# EMAIL_PROVIDER=dev (único disponível por enquanto; provedor real "A definir")
EMAIL_PROVIDER=dev

# --- OCR (PaddleOCR local, sem serviço pago) ---
# OCR_PROVIDER=paddleocr|gemini|neutro (gemini usa PaddleOCR + JSON estruturado Gemini)
OCR_PROVIDER=paddleocr
# Executa extração automaticamente após o upload de um comprovante
OCR_AUTO_ON_UPLOAD=true
# URL interna do serviço PaddleOCR
OCR_PADDLE_URL=http://ocr:8000
# Tempo limite máximo por leitura, em ms
OCR_TIMEOUT_MS=20000
# Obrigatória quando OCR_PROVIDER=gemini
# GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000