generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  EMPLOYEE
  MANAGER_ADMIN
  FINANCE
  FISCAL
}

enum DepartmentType {
  COMERCIAL
  TECNICO
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum UfType {
  AC
  AL
  AM
  AP
  BA
  CE
  DF
  ES
  GO
  MA
  MG
  MS
  MT
  PA
  PB
  PE
  PI
  PR
  RJ
  RN
  RO
  RR
  RS
  SC
  SE
  SP
  TO
}

enum VehicleType {
  PROPRIO
  EMPRESA
  ALUGADO
}

enum TripStatus {
  EM_ANDAMENTO
  EM_APROVACAO
  EM_CORRECAO
  APROVADA
  FINANCEIRO
  FINALIZADA
  CANCELADA
}

enum ReceiptType {
  NOTA_FISCAL
  CUPOM_FISCAL
  NOTA_MANUAL
  COMPROVANTE_CARTAO
  OUTRO
}

enum NotificationEventType {
  VIAGEM_CRIADA
  RELATORIO_ENTREGUE
  RELATORIO_RETORNADO
  RELATORIO_APROVADO
  REEMBOLSO_PAGO
  PROBLEMA_FISCAL
  RELATORIO_REENVIADO
  ADIANTAMENTO_SOLICITADO
  ADIANTAMENTO_APROVADO
  ADIANTAMENTO_RECUSADO
  ADIANTAMENTO_PAGO
}

/// Resultado da validação fiscal de uma despesa (RF-FIS-001).
enum FiscalValidationStatus {
  PENDENTE
  VALIDO
  PROBLEMA
}

/// Situação do processamento OCR de um comprovante (RF-OCR-001).
enum OcrProcessingStatus {
  PENDENTE
  SUCESSO
  FALHA
}

/// Origem dos dados extraídos de um comprovante (RN-OCR-005).
enum OcrSourceType {
  OCR
  MANUAL
}

/// Perfil principal do usuário (RN-ACC-001: exatamente um perfil).
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        RoleType         @unique
  name        String
  description String?
  permissions PermissionRole[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  roles       PermissionRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PermissionRole {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

/// Empresa do cadastro aberto. O primeiro usuário a se registrar é o
/// administrador (MANAGER_ADMIN) da própria empresa (base p/ multi-tenant futuro).
model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  cnpj      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Usuário do sistema (RF-CAD-001). CPF não faz parte do MVP (RN-CAD-002).
model User {
  id                 String                 @id @default(uuid()) @db.Uuid
  name               String
  email              String                 @unique
  phone              String?
  department         DepartmentType
  cargo              String
  roleId             String                 @db.Uuid
  role               Role                   @relation(fields: [roleId], references: [id])
  companyId          String?                @db.Uuid
  company            Company?               @relation(fields: [companyId], references: [id])
  managerId          String?                @db.Uuid
  manager            User?                  @relation("UserManager", fields: [managerId], references: [id])
  subordinates       User[]                 @relation("UserManager")
  status             UserStatus             @default(ATIVO)
  passwordHash       String?
  sessions           Session[]
  invites            InviteToken[]
  passwordResets     PasswordResetToken[]
  auditEvents        AuditEvent[]
  tripsCreated       Trip[]                 @relation("TripCriador")
  tripsDeleted       Trip[]                 @relation("TripDeletadoPor")
  tripParticipants   TripParticipant[]      @relation("TripParticipante")
  participantsAdded  TripParticipant[]      @relation("TripParticipanteAdicionadoPor")
  expensesCreated    Expense[]              @relation("DespesaCriador")
  expensesDeleted    Expense[]              @relation("DespesaDeletadaPor")
  receiptsUploaded   Receipt[]              @relation("ComprovanteUpload")
  limitsUpdated      ExpenseCategoryLimit[] @relation("LimiteAtualizadoPor")
  notifications      Notification[]
  ocrConferido       ReceiptOcr[]           @relation("OcrConferidoPor")
  fiscalValidations  FiscalValidation[]     @relation("FiscalValidadoPor")
  paymentsRegistered TripPayment[]          @relation("PagamentoRegistradoPor")
  advancesRequested  TripAdvance[]          @relation("AdiantamentoSolicitadoPor")
  advancesApproved   TripAdvance[]          @relation("AdiantamentoAprovadoPor")
  advancesPaid       TripAdvance[]          @relation("AdiantamentoPagoPor")
  refundsRegistered  TripRefund[]           @relation("DevolucaoRegistradaPor")
  creditCardsCreated CreditCard[]           @relation("CartaoCriadoPor")
  creditCardsUpdated CreditCard[]           @relation("CartaoAtualizadoPor")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([roleId])
  @@index([companyId])
  @@index([managerId])
}

/// Sessão autenticada no servidor (cookie HttpOnly + revogação + idle timeout).
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  lastActivityAt DateTime  @default(now())
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

/// Convite de primeiro acesso (RF-AUTH-002) com validade limitada (RN-AUTH-009).
model InviteToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Recuperação de senha (RF-AUTH-003) com validade limitada (RN-AUTH-011).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Trilha de auditoria de operações relevantes (RN-AUD-001..010).
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id])
  operation     String
  entityType    String
  entityId      String
  field         String?
  oldValue      String?
  newValue      String?
  justification String?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Viagem (RF-VIA-001..006). Estado controlado pelo fluxo (RN-STA-001..004).
model Trip {
  id                 String            @id @default(uuid()) @db.Uuid
  cliente            String
  cidade             String
  uf                 UfType
  dataSaida          DateTime
  dataRetorno        DateTime
  departamento       DepartmentType
  motivo             String
  veiculo            String?
  placa              String?
  tipoVeiculo        VehicleType?
  kmInicial          Decimal?          @db.Decimal(10, 1)
  kmFinal            Decimal?          @db.Decimal(10, 1)
  taxaKm             Decimal?          @db.Decimal(10, 2)
  centroDeCustoId    String?           @db.Uuid
  centroDeCusto      CostCenter?       @relation(fields: [centroDeCustoId], references: [id])
  observacoes        String?
  status             TripStatus        @default(EM_ANDAMENTO)
  motivoCancelamento String?
  criadoPorId        String            @db.Uuid
  criadoPor          User              @relation("TripCriador", fields: [criadoPorId], references: [id])
  deletadoPorId      String?           @db.Uuid
  deletadoPor        User?             @relation("TripDeletadoPor", fields: [deletadoPorId], references: [id])
  deletadoEm         DateTime?
  participants       TripParticipant[]
  expenses           Expense[]
  notifications      Notification[]
  payments           TripPayment[]
  advances           TripAdvance[]
  refunds            TripRefund[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([criadoPorId])
  @@index([centroDeCustoId])
}

/// Vínculo de participante à viagem (RN-VIA-015..022). Um vínculo por usuário por viagem.
model TripParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation("TripParticipante", fields: [userId], references: [id])
  addedById String   @db.Uuid
  addedBy   User     @relation("TripParticipanteAdicionadoPor", fields: [addedById], references: [id])
  creditCardId String?    @db.Uuid
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@index([userId])
}

/// Cartão corporativo reutilizável em viagens, sem vínculo exclusivo ao titular impresso.
model CreditCard {
  id                   String            @id @default(uuid()) @db.Uuid
  cardholderName       String
  encryptedCardNumber  String
  last4                String            @db.VarChar(4)
  brand                String?
  active               Boolean           @default(true)
  createdById          String            @db.Uuid
  createdBy            User              @relation("CartaoCriadoPor", fields: [createdById], references: [id])
  updatedById          String?           @db.Uuid
  updatedBy            User?             @relation("CartaoAtualizadoPor", fields: [updatedById], references: [id])
  deletedAt            DateTime?
  participants         TripParticipant[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([active])
  @@index([deletedAt])
}

/// Categoria de despesa (RF-DES-002). Categorias nunca são apagadas, apenas desativadas.
model ExpenseCategory {
  id        String                 @id @default(uuid()) @db.Uuid
  code      String                 @unique
  name      String
  ativa     Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  expenses  Expense[]
  limits    ExpenseCategoryLimit[]
}

/// Limite por categoria (RF-LIM-001). Exceder gera alerta, nunca bloqueio (RN-DES-011/012).
model ExpenseCategoryLimit {
  id          String          @id @default(uuid()) @db.Uuid
  categoryId  String          @unique @db.Uuid
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  valor       Decimal         @db.Decimal(12, 2)
  updatedById String          @db.Uuid
  updatedBy   User            @relation("LimiteAtualizadoPor", fields: [updatedById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Centro de custo (RF-CC-001), administrado por Manager/Admin.
model CostCenter {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]
}

/// Despesa (RF-DES-001). Sempre vinculada à viagem e ao participante que lançou.
model Expense {
  id               String            @id @default(uuid()) @db.Uuid
  tripId           String            @db.Uuid
  trip             Trip              @relation(fields: [tripId], references: [id])
  categoryId       String            @db.Uuid
  category         ExpenseCategory   @relation(fields: [categoryId], references: [id])
  createdById      String            @db.Uuid
  createdBy        User              @relation("DespesaCriador", fields: [createdById], references: [id])
  valor            Decimal           @db.Decimal(12, 2)
  dataDespesa      DateTime
  reembolsavel     Boolean
  justificativa    String
  alertaExcesso    Decimal?          @db.Decimal(12, 2)
  deletedAt        DateTime?
  deletedById      String?           @db.Uuid
  deletedBy        User?             @relation("DespesaDeletadaPor", fields: [deletedById], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  receipts         Receipt[]
  fiscalValidation FiscalValidation?

  @@index([tripId])
  @@index([categoryId])
  @@index([createdById])
}

/// Comprovante da despesa (RF-CMP-001/002). Original sempre preservado, nunca removido.
model Receipt {
  id           String      @id @default(uuid()) @db.Uuid
  expenseId    String      @db.Uuid
  expense      Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileData     Bytes       @db.ByteA
  fileType     String
  fileName     String
  fileSize     Int
  fileHash     String
  tipo         ReceiptType
  ativo        Boolean     @default(true)
  uploadedById String      @db.Uuid
  uploadedBy   User        @relation("ComprovanteUpload", fields: [uploadedById], references: [id])
  createdAt    DateTime    @default(now())
  ReceiptOcr   ReceiptOcr?

  @@index([expenseId])
}

/// Dados extraídos pelo OCR de um comprovante (RF-OCR-001). Falha do OCR nunca
/// impede o lançamento manual (RN-OCR-007).
model ReceiptOcr {
  id                  String              @id @default(uuid()) @db.Uuid
  receiptId           String              @unique @db.Uuid
  receipt             Receipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  status              OcrProcessingStatus @default(PENDENTE)
  origem              OcrSourceType       @default(MANUAL)
  cnpj                String?
  nomeEstabelecimento String?
  data                DateTime?
  hora                String?
  valorTotal          Decimal?            @db.Decimal(12, 2)
  numeroDocumento     String?
  chaveAcesso         String?
  itens               Json?
  dadosOriginais      Json?
  erro                String?
  extraidoEm          DateTime?
  conferidoPorId      String?             @db.Uuid
  conferidoPor        User?               @relation("OcrConferidoPor", fields: [conferidoPorId], references: [id])
  conferidoEm         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([receiptId])
}

/// Situação fiscal da despesa (RF-FIS-001). Validação independente da aprovação
/// gerencial (RN-FIS-004); histórico preservado via auditoria (RN-FIS-008).
model FiscalValidation {
  id            String                 @id @default(uuid()) @db.Uuid
  expenseId     String                 @unique @db.Uuid
  expense       Expense                @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  status        FiscalValidationStatus @default(PENDENTE)
  motivo        String?
  validatedById String?                @db.Uuid
  validatedBy   User?                  @relation("FiscalValidadoPor", fields: [validatedById], references: [id])
  validatedAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status])
}

/// Pagamento de reembolso (RF-FIN-001). Respeita exatamente o valor aprovado
/// (RN-FIN-003); comprovante de pagamento opcional (RN-FIN-020).
model TripPayment {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @db.Uuid
  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  valor              Decimal  @db.Decimal(12, 2)
  dataPagamento      DateTime
  observacoes        String?
  responsavelId      String   @db.Uuid
  responsavel        User     @relation("PagamentoRegistradoPor", fields: [responsavelId], references: [id])
  comprovanteData    Bytes?   @db.ByteA
  comprovanteNome    String?
  comprovanteTipo    String?
  comprovanteTamanho Int?
  createdAt          DateTime @default(now())

  @@index([tripId])
}

/// Situação do adiantamento de viagem (RF-FIN-002, RN-FIN-023..035).
enum AdvanceStatus {
  SOLICITADO
  EM_ANALISE
  APROVADO
  RECUSADO
  PAGAMENTO_PENDENTE
  PAGO
}

/// Adiantamento de viagem (RF-FIN-002): solicitado pelo colaborador na abertura
/// da viagem, analisado pelo gestor e pago pelo financeiro (RN-FIN-023..035).
model TripAdvance {
  id                       String        @id @default(uuid()) @db.Uuid
  tripId                   String        @db.Uuid
  trip                     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  solicitadoPorId          String        @db.Uuid
  solicitadoPor            User          @relation("AdiantamentoSolicitadoPor", fields: [solicitadoPorId], references: [id])
  valorSolicitado          Decimal       @db.Decimal(12, 2)
  justificativaSolicitacao String
  status                   AdvanceStatus @default(SOLICITADO)
  valorAprovado            Decimal?      @db.Decimal(12, 2)
  aprovadoPorId            String?       @db.Uuid
  aprovadoPor              User?         @relation("AdiantamentoAprovadoPor", fields: [aprovadoPorId], references: [id])
  aprovadoEm               DateTime?
  justificativaAnalise     String?
  pagoPorId                String?       @db.Uuid
  pagoPor                  User?         @relation("AdiantamentoPagoPor", fields: [pagoPorId], references: [id])
  pagoEm                   DateTime?
  observacoesPagamento     String?
  solicitadoEm             DateTime      @default(now())
  atualizadoEm             DateTime      @updatedAt

  @@index([tripId])
  @@index([status])
}

/// Devolução de saldo pelo colaborador (RF-FIN-003). Registra valor, data e
/// método de pagamento (RN-FIN-015..017); comprovante opcional (RN-FIN-018).
model TripRefund {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @db.Uuid
  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  valor              Decimal  @db.Decimal(12, 2)
  data               DateTime
  metodoDePagamento  String
  observacoes        String?
  comprovanteData    Bytes?   @db.ByteA
  comprovanteNome    String?
  comprovanteTipo    String?
  comprovanteTamanho Int?
  registradoPorId    String   @db.Uuid
  registradoPor      User     @relation("DevolucaoRegistradaPor", fields: [registradoPorId], references: [id])
  createdAt          DateTime @default(now())

  @@index([tripId])
}

/// Central de notificações interna (RF-NOT-001).
model Notification {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @db.Uuid
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEventType
  message   String
  detail    String?
  tripId    String?               @db.Uuid
  trip      Trip?                 @relation(fields: [tripId], references: [id])
  readAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Parâmetros globais do sistema configuráveis no painel admin (RF-CFG-001).
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
